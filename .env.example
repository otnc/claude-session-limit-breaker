# Log / Discord message language (optional). "ja" or "en". Defaults to "en".
# This overrides an OS-level LANG if one is already set.
LANG=en

# Discord webhook URL to notify (optional).
# When set, every run's outcome (success / skipped due to limit / error / login required) is posted to Discord.
# Leave it unset and notifications are silently skipped.
# To get one: Discord channel settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK=
